# Google Maps (Maps SDK for Android / iOS)
# 1) Google Cloud Console → enable Maps SDK for Android + Maps SDK for iOS
# 2) Create API key(s), restrict by package/bundle (uz.denta.client / uz.denta.doctor)
# 3) Put the same key here (or separate keys via GOOGLE_MAPS only for native plugin)
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (client native)
# Download from Firebase Console → Project settings → Your apps
# Place files at repo root (or set absolute/relative paths):
#   google-services.json       (Android)
#   GoogleService-Info.plist   (iOS)
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Optional EAS project id (Expo push helpers)
# EAS_PROJECT_ID=

# DENTA.UZ API — leave empty OR set EXPO_PUBLIC_USE_MOCK_API=true for mocks
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_USE_MOCK_API=true
