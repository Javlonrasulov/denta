# Copy to /opt/denta/.env on server — never commit real secrets
NODE_ENV=production
PORT=4000

POSTGRES_DB=denta_prod
POSTGRES_USER=denta
POSTGRES_PASSWORD=CHANGE_ME_SECURE

# Overridden in compose for internal DNS; kept for reference / tools
DATABASE_URL=postgresql://denta:CHANGE_ME_SECURE@postgres:5432/denta_prod?schema=public
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

TRIAL_DAYS=30
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/.uploads
STORAGE_PUBLIC_BASE_URL=https://denta.taomim.uz/uploads

CORS_ORIGINS=https://denta.taomim.uz
APP_WEB_URL=https://denta.taomim.uz
NEXT_PUBLIC_API_URL=https://denta.taomim.uz/api/v1

CLIENT_APP_SCHEME=denta-client
DOCTOR_APP_SCHEME=denta-doctor
UPLOAD_MAX_BYTES=5242880
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=info

# Optional — leave empty until credentials exist (feature blockers)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DENTA.UZ <noreply@denta.uz>

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=denta
S3_FORCE_PATH_STYLE=true
