# Production mobile release env (EAS / local release builds)
# Copy values into EAS secrets or .env.production — do NOT commit real keys.

EXPO_PUBLIC_API_URL=https://denta.taomim.uz/api/v1
# EXPO_PUBLIC_USE_MOCK_API must stay unset/false in production

# Google Maps — restrict key by package:
#   Android: uz.denta.client / uz.denta.doctor
#   iOS: matching bundle IDs
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Firebase native config files (not env strings):
#   google-services.json
#   GoogleService-Info.plist
