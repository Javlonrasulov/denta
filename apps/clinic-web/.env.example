# Clinic Web — Auth / API
# Default: real API. Leave empty only if you need localStorage auth mock.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase Web (Clinic CRM browser push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional support contacts on trial-expired paywall
# NEXT_PUBLIC_SUPPORT_PHONE=+998 71 200 00 00
# NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/dentauz

# Legal pages (/terms, /privacy). See docs/LEGAL_REVIEW.md before production launch.
# Versions must match API LEGAL_TERMS_VERSION / LEGAL_PRIVACY_VERSION.
NEXT_PUBLIC_LEGAL_TERMS_VERSION=2026-09-27
NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=2026-09-27
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-09-27
NEXT_PUBLIC_LEGAL_UPDATED_DATE=2026-09-27
# Operator (service provider) details shown in the documents
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_TIN=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=
# Days after the due date before paid features may be limited (default 5)
NEXT_PUBLIC_LEGAL_GRACE_DAYS=5
# Days of non-payment before the service may be suspended (default 30)
NEXT_PUBLIC_LEGAL_SUSPENSION_DAYS=30
