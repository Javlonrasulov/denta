NODE_ENV=development
PORT=4000

# Required — local PostgreSQL
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/denta?schema=public
DATABASE_URL=postgresql://denta:denta@localhost:5432/denta?schema=public

# Optional — if missing/unreachable in development, in-memory fallback is used
REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

TRIAL_DAYS=30
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DENTA.UZ <noreply@denta.uz>"

# local (default in development) | s3 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=denta
S3_FORCE_PATH_STYLE=true

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines as \n in .env
FIREBASE_PRIVATE_KEY=

# Push is disabled until all three FIREBASE_* values are set.
# PushService never returns fake success without credentials.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_WEB_URL=http://localhost:3000
CLIENT_APP_SCHEME=denta-client
DOCTOR_APP_SCHEME=denta-doctor

UPLOAD_MAX_BYTES=5242880
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=debug

# Optional Docker convenience (not required):
#   docker compose -f docker-compose.dev.yml up -d
